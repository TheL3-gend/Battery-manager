<Window x:Class="BatteryManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BatteryManager.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding AppTitle}"
        Width="1180"
        Height="820"
        MinWidth="980"
        MinHeight="720"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        CornerRadius="18"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="6" />
  </shell:WindowChrome.WindowChrome>

  <Border Margin="12"
          CornerRadius="18"
          Background="{DynamicResource WindowBackgroundBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1">
    <Grid x:Name="ShellRoot" Margin="18" Opacity="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid x:Name="TitleBar"
            Height="38"
            Background="Transparent"
            MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Battery Manager" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     Text="{Binding StatusHeadline}"
                     Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>
        <Button Grid.Column="1" Content="-" Style="{StaticResource WindowChromeButtonStyle}" Click="MinimizeButton_OnClick" />
        <Button Grid.Column="2" Content="□" Style="{StaticResource WindowChromeButtonStyle}" Click="MaximizeButton_OnClick" />
        <Button Grid.Column="3" Content="×" Style="{StaticResource WindowChromeCloseButtonStyle}" Click="CloseButton_OnClick" />
      </Grid>

      <ScrollViewer Grid.Row="1"
                    Margin="0,12,0,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    CanContentScroll="False">
        <Grid VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.45*" />
            <ColumnDefinition Width="0.95*" />
          </Grid.ColumnDefinitions>

        <Grid x:Name="LeftPanel" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform>
            <TranslateTransform Y="10" />
          </Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource HeroCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="0.9*" />
          </Grid.ColumnDefinitions>

          <StackPanel>
            <TextBlock Text="Battery Manager" Style="{StaticResource HeroTitleStyle}" />
            <TextBlock Margin="0,4,0,0" Text="{Binding StatusHeadline}" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Margin="0,8,0,0" Text="{Binding StatusDetail}" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />

            <StackPanel Margin="0,14,0,0">
              <Border HorizontalAlignment="Left" Style="{StaticResource StatusBadgeStyle}">
                <TextBlock Text="{Binding ChargeLimitAvailabilityText}" Style="{StaticResource BadgeTextStyle}" />
              </Border>
              <Border Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource StatusBadgeStyle}">
                <TextBlock Text="{Binding TopUpAvailabilityText}" Style="{StaticResource BadgeTextStyle}" />
              </Border>
            </StackPanel>

            <UniformGrid Margin="0,18,0,0" Columns="3">
              <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                  <TextBlock Text="Charge flow" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Text="{Binding ChargeWattsText}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                  <TextBlock Text="System draw" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Text="{Binding SystemWattsText}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource MiniCardStyle}">
                <StackPanel>
                  <TextBlock Text="Adapter to system" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Text="{Binding SystemAdapterWattsText}" Style="{StaticResource MetricValueStyle}" />
                </StackPanel>
              </Border>
            </UniformGrid>
          </StackPanel>

          <Border Grid.Column="1"
                  Margin="20,0,0,0"
                  Padding="18"
                  CornerRadius="18"
                  Background="{DynamicResource HeroPanelBrush}">
            <StackPanel>
              <TextBlock Text="Live battery" Style="{StaticResource SectionTitleStyle}" />
              <TextBlock Margin="0,12,0,0"
                         HorizontalAlignment="Center"
                         Text="{Binding BatteryPercentText}"
                         Style="{StaticResource HeroMetricStyle}" />
              <ProgressBar Margin="0,10,0,0"
                           Value="{Binding BatteryPercentValue, Mode=OneWay}"
                           Maximum="100"
                           Style="{StaticResource PremiumProgressBarStyle}" />
              <Border Margin="0,14,0,0"
                      Padding="10,8"
                      CornerRadius="10"
                      Background="{DynamicResource CardSecondaryBrush}">
                <TextBlock Text="{Binding TopUpStateText}" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />
              </Border>
              <TextBlock Margin="0,12,0,0"
                         Text="{Binding LiveUpdateNote}"
                         TextWrapping="Wrap"
                         Style="{StaticResource BodyTextStyle}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource DashboardCardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="130" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel>
            <TextBlock Text="Power flow history" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Bottom"
                       Text="Recent charging and system draw"
                       Style="{StaticResource CaptionTextStyle}" />
          </DockPanel>

          <controls:LineChart Grid.Row="1"
                              Margin="0,16,0,0"
                              ItemsSource="{Binding ChargePowerHistory}"
                              Maximum="120"
                              Stroke="{DynamicResource AccentBrush}"
                              Fill="{DynamicResource AccentBrush}" />

          <UniformGrid Grid.Row="2" Margin="0,16,0,0" Columns="3">
            <Border Style="{StaticResource MiniCardStyle}">
              <StackPanel>
                <TextBlock Text="Battery charging" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding ChargeWattsText}" Style="{StaticResource MiniMetricValueStyle}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniCardStyle}">
              <StackPanel>
                <TextBlock Text="System from battery" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding SystemWattsText}" Style="{StaticResource MiniMetricValueStyle}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniCardStyle}">
              <StackPanel>
                <TextBlock Text="Adapter to system" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding SystemAdapterWattsText}" Style="{StaticResource MiniMetricValueStyle}" />
              </StackPanel>
            </Border>
          </UniformGrid>
        </Grid>
      </Border>

      <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource DashboardCardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel>
            <TextBlock Text="Battery status" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Bottom"
                       Text="Health, temperature, runtime, and history"
                       Style="{StaticResource CaptionTextStyle}" />
          </DockPanel>

          <UniformGrid Grid.Row="1" Margin="0,16,0,0" Columns="4">
            <Border Style="{StaticResource MiniCardStyle}">
              <StackPanel>
                <TextBlock Text="Health" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding BatteryHealthText}" Style="{StaticResource MiniMetricValueStyle}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniCardStyle}">
              <StackPanel>
                <TextBlock Text="Temperature" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource MiniMetricValueStyle}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniCardStyle}">
              <StackPanel>
                <TextBlock Text="Time left" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding TimeRemainingText}" Style="{StaticResource MiniMetricValueStyle}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniCardStyle}">
              <StackPanel>
                <TextBlock Text="Cycle count" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding CycleCountText}" Style="{StaticResource MiniMetricValueStyle}" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Grid.Row="2"
                  Grid.RowSpan="2"
                  Margin="0,16,0,0"
                  CornerRadius="18"
                  BorderBrush="{DynamicResource UsagePanelBorderBrush}"
                  BorderThickness="1"
                  Background="{DynamicResource UsagePanelBrush}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Border Padding="16,14"
                      CornerRadius="18,18,0,0"
                      Background="{DynamicResource UsageHeaderBrush}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Path Width="26"
                        Height="26"
                        Stroke="{DynamicResource UsageHeaderTextBrush}"
                        StrokeThickness="1.9"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Data="M2,22 L2,5 M2,22 L24,22 M7,15 L12,10 L17,13 L23,7" />
                  <TextBlock Grid.Column="1"
                             Margin="14,0,0,0"
                             VerticalAlignment="Center"
                             Text="Battery usage"
                             Style="{StaticResource UsageTitleTextStyle}" />
                  <Path Grid.Column="2"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Stroke="{DynamicResource UsageMutedTextBrush}"
                        StrokeThickness="1.8"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Data="M2,10 L8,4 L14,10" />
                </Grid>
              </Border>

              <Grid Grid.Row="1" Margin="18,18,18,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Battery levels" Style="{StaticResource UsageTitleTextStyle}" />
                  <TextBlock Margin="0,6,0,0"
                             Text="{Binding BatteryHistoryResolutionLabel}"
                             Style="{StaticResource UsageCaptionTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Margin="0,0,12,0"
                             VerticalAlignment="Center"
                             Text="Time period:"
                             Style="{StaticResource UsageBodyTextStyle}" />
                  <Border Padding="12,8"
                          CornerRadius="10"
                          Background="{DynamicResource UsageSummaryBrush}"
                          BorderBrush="{DynamicResource UsageSummaryBorderBrush}"
                          BorderThickness="1">
                    <TextBlock Text="{Binding BatteryHistoryCaption}" Style="{StaticResource UsageBodyTextStyle}" />
                  </Border>
                  <Button Margin="10,0,0,0"
                          Content="24h"
                          Command="{Binding SetBatteryHistoryPeriodCommand}"
                          CommandParameter="Day"
                          Style="{StaticResource HistoryRangeButtonStyle}"
                          Tag="{Binding IsDayHistorySelected}" />
                  <Button Margin="8,0,0,0"
                          Content="7 days"
                          Command="{Binding SetBatteryHistoryPeriodCommand}"
                          CommandParameter="Week"
                          Style="{StaticResource HistoryRangeButtonStyle}"
                          Tag="{Binding IsWeekHistorySelected}" />
                </StackPanel>
              </Grid>

              <Grid Grid.Row="2" Margin="18,16,18,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:BatteryUsageChart Height="320"
                                            ItemsSource="{Binding BatteryUsageHistory}" />

                <Grid Grid.Row="1" Margin="52,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding BatteryUsageAxisStartLabel}" Style="{StaticResource UsageAxisTextStyle}" />
                  <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="{Binding BatteryUsageAxisQuarterLabel}" Style="{StaticResource UsageAxisTextStyle}" />
                  <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="{Binding BatteryUsageAxisMidLabel}" Style="{StaticResource UsageAxisTextStyle}" />
                  <TextBlock Grid.Column="3" HorizontalAlignment="Center" Text="{Binding BatteryUsageAxisThreeQuarterLabel}" Style="{StaticResource UsageAxisTextStyle}" />
                  <TextBlock Grid.Column="4" HorizontalAlignment="Right" Text="{Binding BatteryUsageAxisEndLabel}" Style="{StaticResource UsageAxisTextStyle}" />
                </Grid>
              </Grid>

              <Grid Grid.Row="3" Margin="18,20,18,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                  <UniformGrid Columns="3">
                    <Border Margin="0,0,10,0" Style="{StaticResource UsageMetricCardStyle}">
                      <StackPanel>
                        <TextBlock Text="Current" Style="{StaticResource UsageCaptionTextStyle}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding BatteryUsageCurrentLabel}" Style="{StaticResource UsageTitleTextStyle}" />
                      </StackPanel>
                    </Border>
                    <Border Margin="0,0,10,0" Style="{StaticResource UsageMetricCardStyle}">
                      <StackPanel>
                        <TextBlock Text="Lowest" Style="{StaticResource UsageCaptionTextStyle}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding BatteryUsageLowLabel}" Style="{StaticResource UsageTitleTextStyle}" />
                      </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource UsageSummaryAccentBrush}"
                            BorderBrush="{DynamicResource UsageSummaryBorderBrush}"
                            BorderThickness="1"
                            Style="{StaticResource UsageMetricCardStyle}">
                      <StackPanel>
                        <TextBlock Text="Highest" Style="{StaticResource UsageCaptionTextStyle}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding BatteryUsageHighLabel}" Style="{StaticResource UsageTitleTextStyle}" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Bottom">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="12"
                            Height="12"
                            CornerRadius="6"
                            Background="{DynamicResource UsageBarBrush}"
                            BorderBrush="{DynamicResource UsageBarBorderBrush}"
                            BorderThickness="1" />
                    <TextBlock Margin="8,0,0,0" Text="On battery" Style="{StaticResource UsageBodyTextStyle}" />
                  </StackPanel>
                  <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Border Width="12"
                            Height="12"
                            CornerRadius="6"
                            Background="{DynamicResource UsageChargingBarBrush}"
                            BorderBrush="{DynamicResource UsageBarBorderBrush}"
                            BorderThickness="1" />
                    <TextBlock Margin="8,0,0,0" Text="Charging" Style="{StaticResource UsageBodyTextStyle}" />
                  </StackPanel>
                  <TextBlock Margin="0,12,0,0" Text="{Binding BatteryUsageSamplesLabel}" Style="{StaticResource UsageCaptionTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                  <TextBlock HorizontalAlignment="Right" Text="{Binding BatteryUsageStateLabel}" Style="{StaticResource UsageTitleTextStyle}" />
                  <TextBlock Margin="0,8,0,0" HorizontalAlignment="Right" Text="{Binding BatteryHistoryCaption}" Style="{StaticResource UsageBodyTextStyle}" />
                  <Border Margin="0,10,0,0"
                          Padding="10,6"
                          CornerRadius="10"
                          Background="{DynamicResource UsageSummaryBrush}"
                          BorderBrush="{DynamicResource UsageSummaryBorderBrush}"
                          BorderThickness="1">
                    <TextBlock HorizontalAlignment="Right"
                               Text="{Binding BatteryUsageFlowLabel}"
                               Style="{StaticResource UsageBodyTextStyle}" />
                  </Border>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>

        </Grid>

    <Grid x:Name="RightPanel" Grid.Column="1" Margin="18,0,0,0" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <TranslateTransform Y="14" />
      </Grid.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Style="{StaticResource DashboardCardStyle}">
        <StackPanel>
          <TextBlock Text="Charge limit" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock Margin="0,8,0,0" Text="{Binding ChargeLimitAvailabilityText}" TextWrapping="Wrap" Style="{StaticResource SupportHeadlineStyle}" />
          <TextBlock Margin="0,8,0,0" Text="{Binding ChargeLimitMessage}" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />

          <UniformGrid Margin="0,16,0,0" Columns="4">
            <Button Content="60%" Command="{Binding ApplyChargeLimitCommand}" CommandParameter="60" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding ChargeLimitSupported}" ToolTip="{Binding ChargeLimitAvailabilityText}" ToolTipService.ShowOnDisabled="True" />
            <Button Content="70%" Command="{Binding ApplyChargeLimitCommand}" CommandParameter="70" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding ChargeLimitSupported}" ToolTip="{Binding ChargeLimitAvailabilityText}" ToolTipService.ShowOnDisabled="True" />
            <Button Content="80%" Command="{Binding ApplyChargeLimitCommand}" CommandParameter="80" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding ChargeLimitSupported}" ToolTip="{Binding ChargeLimitAvailabilityText}" ToolTipService.ShowOnDisabled="True" />
            <Button Content="90%" Command="{Binding ApplyChargeLimitCommand}" CommandParameter="90" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding ChargeLimitSupported}" ToolTip="{Binding ChargeLimitAvailabilityText}" ToolTipService.ShowOnDisabled="True" />
          </UniformGrid>

          <TextBlock Margin="0,16,0,0" Text="Custom threshold" Style="{StaticResource LabelTextStyle}" />
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider Minimum="50"
                    Maximum="100"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Value="{Binding CustomChargeLimit}"
                    IsEnabled="{Binding ChargeLimitSupported}"
                    ToolTip="{Binding ChargeLimitAvailabilityText}"
                    ToolTipService.ShowOnDisabled="True" />
            <TextBlock Grid.Column="1"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding CustomChargeLimit}"
                       Style="{StaticResource MiniMetricValueStyle}" />
          </Grid>

          <CheckBox Margin="0,12,0,0"
                    Content="Use custom threshold"
                    IsChecked="{Binding UseCustomChargeLimit}"
                    Style="{StaticResource PremiumCheckBoxStyle}"
                    IsEnabled="{Binding ChargeLimitSupported}"
                    ToolTip="{Binding ChargeLimitAvailabilityText}"
                    ToolTipService.ShowOnDisabled="True" />

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Apply limit"
                    Command="{Binding ApplyChargeLimitCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding ChargeLimitSupported}"
                    ToolTip="{Binding ChargeLimitAvailabilityText}"
                    ToolTipService.ShowOnDisabled="True" />
            <Button Grid.Column="1"
                    Margin="10,0,0,0"
                    Content="Top Up"
                    Command="{Binding EnableTopUpCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="{Binding TopUpSupported}"
                    ToolTip="{Binding TopUpAvailabilityText}"
                    ToolTipService.ShowOnDisabled="True" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Margin="0,16,0,0" Style="{StaticResource DashboardCardStyle}">
        <StackPanel>
          <TextBlock Text="Compatibility" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock Margin="0,8,0,0" Text="{Binding CompatibilityHeadline}" TextWrapping="Wrap" Style="{StaticResource SupportHeadlineStyle}" />
          <TextBlock Margin="0,8,0,0" Text="{Binding CompatibilityDetail}" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}" />

          <Border Margin="0,14,0,0" Style="{StaticResource StatusBadgeStyle}">
            <TextBlock Text="{Binding ProviderName}" Style="{StaticResource BadgeTextStyle}" />
          </Border>

          <UniformGrid Margin="0,14,0,0" Columns="2">
            <Border Style="{StaticResource MiniCardStyle}">
              <StackPanel>
                <TextBlock Text="Manufacturer" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource MiniMetricValueStyle}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource MiniCardStyle}">
              <StackPanel>
                <TextBlock Text="Model" Style="{StaticResource LabelTextStyle}" />
                <TextBlock Text="{Binding Model}" Style="{StaticResource MiniMetricValueStyle}" />
              </StackPanel>
            </Border>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource DashboardCardStyle}">
        <StackPanel>
          <TextBlock Text="Settings" Style="{StaticResource SectionTitleStyle}" />
          <CheckBox Margin="0,14,0,0" Content="Dark mode" IsChecked="{Binding UseDarkMode}" Style="{StaticResource PremiumCheckBoxStyle}" />
          <CheckBox Margin="0,10,0,0" Content="Keep monitoring in background" IsChecked="{Binding BackgroundMonitoringEnabled}" Style="{StaticResource PremiumCheckBoxStyle}" />
          <CheckBox Margin="0,10,0,0" Content="Start minimized to tray" IsChecked="{Binding StartMinimizedToTray}" Style="{StaticResource PremiumCheckBoxStyle}" />

          <TextBlock Margin="0,18,0,0" Text="Refresh interval" Style="{StaticResource LabelTextStyle}" />
          <Slider Margin="0,8,0,0"
                  Minimum="1"
                  Maximum="10"
                  TickFrequency="1"
                  IsSnapToTickEnabled="True"
                  Value="{Binding RefreshIntervalSeconds}" />
          <TextBlock Margin="0,8,0,0"
                     Text="{Binding RefreshIntervalSeconds, StringFormat={}{0} seconds}"
                     Style="{StaticResource BodyTextStyle}" />
        </StackPanel>
      </Border>
    </Grid>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
