<UserControl x:Class="BatteryManager.Controls.LineChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <Border Padding="8"
          CornerRadius="12"
          Background="#08FFFFFF"
          BorderBrush="#18FFFFFF"
          BorderThickness="1">
    <Grid ClipToBounds="True">
      <Grid IsHitTestVisible="False" Opacity="0.35">
        <Grid.RowDefinitions>
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#20A7B3C2" BorderThickness="0,0,0,1" />
        <Border Grid.Row="1" BorderBrush="#20A7B3C2" BorderThickness="0,0,0,1" />
        <Border Grid.Row="2" BorderBrush="#20A7B3C2" BorderThickness="0,0,0,1" />
      </Grid>
      <Path x:Name="FillPath"
            Fill="{Binding Fill, ElementName=Root}"
            Opacity="0.16" />
      <Path x:Name="LinePath"
            Stroke="{Binding Stroke, ElementName=Root}"
            StrokeThickness="2.5"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round" />
    </Grid>
  </Border>
</UserControl>
